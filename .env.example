# ============================================================================
# REQUIRED: API Keys & Credentials
# ============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_specific_password_here

# ============================================================================
# OPTIONAL: Screening Parameters
# ============================================================================
# Minimum stock drop percentage to include in analysis (must be negative)
# Default: -6.0 (6% drop)
DROP_THRESHOLD=-6.0

# Historical data lookback period for yfinance
# Default: 2d (2 days)
LOOKBACK_PERIOD=2d

# ============================================================================
# OPTIONAL: Gemini AI Configuration
# ============================================================================
# AI model to use for analysis
# Default: gemini-3.5-flash-lite
# Options: gemini-2.0-flash, gemini-exp-1206, etc.
GEMINI_MODEL=gemini-3.5-flash-lite

# Minimum analyst target upside (%) to consider a stock
# Default: 15.0 (15% upside)
MIN_UPSIDE_THRESHOLD=15.0

# Number of stocks to analyze per category (Group 1 & Group 2)
# Default: 4
STOCKS_PER_GROUP=4

# ============================================================================
# OPTIONAL: Email Configuration
# ============================================================================
# Recipient email addresses (comma-separated for multiple recipients)
# If not set, defaults to GMAIL_USER
# Example: user1@example.com, user2@example.com, user3@example.com
EMAIL_RECIPIENTS=your_email@gmail.com

# Subject line for daily report email
# Default: DigForMe_USA - Daily AI Stock Report 📈
EMAIL_SUBJECT=DigForMe_USA - Daily AI Stock Report 📈

# ============================================================================
# OPTIONAL: Debugging
# ============================================================================
# Enable debug mode for verbose logging
# Default: False
DEBUG=False

# Enable verbose output
# Default: False
VERBOSE=False
